# KAIROS - Plantilla de variables de entorno
# Copia este archivo a .env y ajusta los valores para tu entorno local/producción.
# NUNCA subas el archivo .env real al repositorio.

# Django
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Base de datos (opcional, descomenta y configura para PostgreSQL)
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/kairos

# Redis / Channels (Fase 2 - WebSockets, opcional)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# CORS / CSRF (opcional, separa por comas si necesitas más orígenes)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
